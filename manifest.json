{
  "manifest_version": 3,
  "name": "Behavior Capture — Privacy-first",
  "version": "0.1",
  "description": "Captures timing-only typing, mouse, and video metadata for aggregation. Does NOT capture key values or URLs.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_keyboard.js",
        "content_mouse.js",
        "content_video.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Behavior Capture"
  }
}